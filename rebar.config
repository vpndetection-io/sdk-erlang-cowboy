%% Cowboy is the framework this adapts, and vpndetection carries the
%% framework-agnostic half. Nothing else: everything the middleware needs beyond
%% those two is in OTP, which is why the floor is 27 - `json' arrived in stdlib
%% there, and it is also the oldest OTP release still supported upstream.
{minimum_otp_vsn, "27"}.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [{cowboy, "~> 2.13"}, {vpndetection, "~> 3.3"}]}.

{eunit_opts, [verbose]}.

%% The dependency apps go in the PLT explicitly: without ranch, cowboy's own
%% specs reference ranch:ref/0 and the `unknown' warning class fires on code we
%% do not own.
{dialyzer, [{warnings, [unknown, unmatched_returns]},
            {plt_extra_apps, [cowboy, cowlib, ranch, vpndetection]}]}.

{xref_checks, [undefined_function_calls, undefined_functions, locals_not_used,
               deprecated_function_calls, deprecated_functions]}.

%% The publishing plugins live in their own profile, so an ordinary build or test
%% run needs no network and no plugin at all. Publish with:
%%   rebar3 as publish hex publish
{profiles, [{publish, [{plugins, [{rebar3_hex, "~> 7.2"}, rebar3_ex_doc]}]}]}.

{hex, [{doc, ex_doc}]}.

{ex_doc, [{source_url, <<"https://github.com/vpndetection-io/sdk-erlang-cowboy">>},
          {extras, [<<"README.md">>, <<"LICENSE">>]},
          {main, <<"readme">>}]}.
